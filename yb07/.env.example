# Pour MYSQL
SGBD_SERVER_READ=localhost
SGBD_SERVER_WRITE=localhost
SGBD_PORT=3306
SGBD_DB_NAME=yb07
SGBD_APP_USER_READ=root
SGBD_APP_USER_WRITE=root
SGBD_APP_USER=root
#SGBD_APP_PWD=your_password
#SGBD_APP_PWD_READ=your_read_password
#SGBD_APP_PWD_WRITE=your_write_password
SGBD_MAX_RETRIES=3
SGBD_RETRY_DELAY=1.0

# Taille maximale des pools de connexions MySQL (lecture et ecriture).
# A relever si le module traite plusieurs unites en parallele : chaque tache
# detient au plus une connexion par pool.
MYSQL_POOL_SIZE=10
# Age maximal (s) d'une connexion inactive du pool avant renouvellement.
# A garder sous le wait_timeout du serveur MySQL.
MYSQL_POOL_RECYCLE=600
# Sondes TCP keepalive (s) : evite qu'un proxy/pare-feu coupe une instruction longue.
SGBD_TCP_KEEPALIVE=60
# Suivi (s) des ecritures longues : etat MySQL, phase et % de l'ALTER dans les logs.
SGBD_SUIVI_INSTRUCTION=30
# Classement des connexions ; vide = celui de la base (evite l'erreur 1267).
SGBD_COLLATION=

# Scripts SQL : taille (octets) au-dela de laquelle un avertissement est logge
# (le fichier est entierement charge en memoire avant decoupage).
SQL_SCRIPT_WARN_SIZE=10485760

# S3 — source des fichiers a charger.
# Si AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY sont vides, boto3 resout seul les
# identifiants (role de la machine, profil ~/.aws). Pas de region : us-east-1 par defaut.
# Un S3_ENDPOINT_URL renseigne force l'adressage path-style (MinIO, Ceph...).
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Prefixe (dossier) dans le bucket, sans slash de debut ni de fin. Vide = racine.
S3_PREFIXE=
# Delai d'attente reseau, en secondes.
S3_TIMEOUT=60
# Bundle CA pour le proxy d'inspection TLS de l'entreprise (meme certificat que
# python/). Chemin relatif a la racine de yb07 ou absolu. Vide = certificats par defaut.
S3_CA_BUNDLE=certif/cacert.pem
# Mettre a false UNIQUEMENT en dev pour ignorer la verification TLS (risque MITM)
S3_VERIFY_SSL=true

# Fichiers CSV. Le nom change a chaque livraison du metier : il se configure ici.
CSV_CLES_REPARTITION=cles_repartitions_final_joined_ref1.csv
CSV_DELIMITEUR=;
CSV_ENCODAGE=utf-8-sig

# Chargements de masse.
# Nombre de lignes par lot insere (chaque lot est commite separement).
CHARGEMENT_TAILLE_LOT=5000
# Frequence des lignes de log d'avancement, en nombre de lignes chargees.
CHARGEMENT_LOG_TOUTES_LES=100000
# Avec --skip-errors : nombre de lignes ecartees detaillees dans le rapport et les logs.
CHARGEMENT_MAX_REJETS_DETAILLES=100
# Attente maximale (s) d'un verrou pour tout le DDL : TRUNCATE, index, migration, correctif.
CHARGEMENT_LOCK_WAIT_TIMEOUT=60
# false (defaut) : index conserves pendant le chargement, sans ALTER final long.
# true : index retires puis reconstruits (plus rapide, ALTER final de plusieurs minutes).
CHARGEMENT_RETIRER_INDEX=false

# Commande init - chaine d'initialisation des cles de repartition.
# Frequence des lignes d'avancement de l'etape versions, en nombre de sites traites.
INIT_LOG_TOUS_LES_SITES=50
# Etape versions : sites par lot (une connexion, une transaction par lot).
INIT_VERSIONS_TAILLE_LOT=1000
# Plafond des sommes de cles hors tolerance journalisees une a une (etape cles).
INIT_MAX_ANOMALIES_LOGUEES=50

# json_formatter configuration
APP=dsr
# Environnements possibles : local, sdev, sacc, sass, prod
# Ne pas mettre de commentaire en fin de ligne : dotenv l'inclurait dans la valeur.
APP_ENV=sdev
MODULE=yb07
APP_VERSION=1.0.0
# LOGS_DIR=/logs  (optionnel, utilise uniquement si APP_ENV=local ou chemin explicite)
