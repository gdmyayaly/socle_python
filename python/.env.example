# Pour MYSQL
SGBD_SERVER_READ=localhost
SGBD_SERVER_WRITE=localhost
SGBD_PORT=3306
MYSQL_DATABASE=trppu
SGBD_APP_USER_READ=root
SGBD_APP_USER_WRITE=root
SGBD_APP_USER=root
SKIP_MYSQL=true
#SGBD_APP_PWD=your_password
#SGBD_APP_PWD_READ=your_read_password
#SGBD_APP_PWD_WRITE=your_write_password
SGBD_MAX_RETRIES=3
SGBD_RETRY_DELAY=1.0

# Databricks SQL Warehouse
DATABRICKS_SERVER_HOSTNAME=dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxx
DATABRICKS_CLIENT_ID=your_client_id
DATABRICKS_CLIENT_SECRET=your_client_secret
DATABRICKS_CATALOG=gold
DATABRICKS_SCHEMA=default
DATABRICKS_TIMEOUT=120
DATABRICKS_MAX_RETRIES=3
DATABRICKS_RETRY_DELAY=2.0

# API jours fermes (tournees)
JOURS_FERMES_API_BASE_URL=http://host/tournees/jours-fermes/v1
JOURS_FERMES_API_USERNAME=
JOURS_FERMES_API_PASSWORD=
JOURS_FERMES_API_TIMEOUT=10
# Bundle CA pour le proxy d'inspection TLS (chemin relatif a la racine projet ou absolu)
JOURS_FERMES_API_CA_BUNDLE=certif/cacert.pem
# Mettre a false UNIQUEMENT en dev pour ignorer la verification TLS (risque MITM)
JOURS_FERMES_API_VERIFY_SSL=true
JOURS_FERMES_CACHE_TTL=86400

# Cle de cryptage reversible de l'id_rh (Fernet).
# Vide => cryptage desactive (id_rh stocke en clair, a reserver au dev).
# Accepte un secret arbitraire (derive en cle) ou une cle Fernet native (44 car.).
# Exemple de cle Fernet native :
# ID_RH_CRYPTO_KEY=xL6u0-upfds28yEZH6XeHgRERlXcJyKZEK8APlRMRlE=

# Pour voir les requetes envoyees a databricks
DEBUG_SHOW_QUERY=false

# json_formatter configuration
APP=dsr
APP_ENV=sdev  # Pour les env nous avons local,sdev,sacc,sass,prod
MODULE=ys04
APP_VERSION=1.0.0
# LOGS_DIR=/logs  (optionnel, utilise uniquement si APP_ENV=local ou chemin explicite)
