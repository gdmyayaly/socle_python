# Pour MYSQL
SGBD_SERVER_READ=localhost
SGBD_SERVER_WRITE=localhost
SGBD_PORT=3306
SGBD_DB_NAME=yb04
SGBD_APP_USER_READ=root
SGBD_APP_USER_WRITE=root
SGBD_APP_USER=root
#SGBD_APP_PWD=your_password
#SGBD_APP_PWD_READ=your_read_password
#SGBD_APP_PWD_WRITE=your_write_password
SGBD_MAX_RETRIES=3
SGBD_RETRY_DELAY=1.0

# Taille maximale des pools de connexions MySQL (lecture et ecriture).
# A relever si le module traite plusieurs unites en parallele : chaque tache
# detient au plus une connexion par pool.
MYSQL_POOL_SIZE=10

# Scripts SQL : taille (octets) au-dela de laquelle un avertissement est logge
# (le fichier est entierement charge en memoire avant decoupage).
SQL_SCRIPT_WARN_SIZE=10485760

# S3 — source des fichiers a charger.
# Si S3_ACCESS_KEY / S3_SECRET_KEY sont vides, boto3 resout seul les identifiants
# (role de la machine, profil ~/.aws, variables AWS_*).
# Un S3_ENDPOINT_URL renseigne force l'adressage path-style (MinIO, Ceph...).
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_BUCKET=
# Prefixe (dossier) dans le bucket, sans slash de debut ni de fin. Vide = racine.
S3_PREFIXE=
# Delai d'attente reseau, en secondes.
S3_TIMEOUT=60

# Fichiers CSV. Le nom change a chaque livraison du metier : il se configure ici.
CSV_CLES_REPARTITION=cles_repartitions_final_joined_ref1.csv
CSV_DELIMITEUR=;
CSV_ENCODAGE=utf-8-sig

# Chargements de masse.
# Nombre de lignes par lot insere (chaque lot est commite separement).
CHARGEMENT_TAILLE_LOT=5000
# Frequence des lignes de log d'avancement, en nombre de lignes chargees.
CHARGEMENT_LOG_TOUTES_LES=100000

# json_formatter configuration
APP=dsr
# Environnements possibles : local, sdev, sacc, sass, prod
# Ne pas mettre de commentaire en fin de ligne : dotenv l'inclurait dans la valeur.
APP_ENV=sdev
MODULE=yb04
APP_VERSION=1.0.0
# LOGS_DIR=/logs  (optionnel, utilise uniquement si APP_ENV=local ou chemin explicite)
