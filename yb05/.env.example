# Pour MYSQL
SGBD_SERVER_READ=localhost
SGBD_SERVER_WRITE=localhost
SGBD_PORT=3306
SGBD_DB_NAME=yb05
SGBD_APP_USER_READ=root
SGBD_APP_USER_WRITE=root
SGBD_APP_USER=root
#SGBD_APP_PWD=your_password
#SGBD_APP_PWD_READ=your_read_password
#SGBD_APP_PWD_WRITE=your_write_password
SGBD_MAX_RETRIES=3
SGBD_RETRY_DELAY=1.0
# Age maximal (s) d'une connexion inactive du pool avant renouvellement.
MYSQL_POOL_RECYCLE=600
# Sondes TCP keepalive (s) : evite qu'un proxy/pare-feu coupe une requete longue.
SGBD_TCP_KEEPALIVE=60
# Classement des connexions ; vide = celui de la base (evite l'erreur 1267).
SGBD_COLLATION=

# Scripts SQL : taille (octets) au-dela de laquelle un avertissement est logge
# (le fichier est entierement charge en memoire avant decoupage).
SQL_SCRIPT_WARN_SIZE=10485760

# Mode ALL (DSR-704) : nombre de scenarios traites simultanement.
# 1 = sequentiel (defaut). La taille des pools MySQL suit cette valeur.
NB_WORKER=1

# Calcul des trafics PDI (DSR-702) : quelle cle de repartition appliquer a quel produit.
# Familles reconnues : colis, oo, 3s, potentielip. Un produit absent de cette liste fait
# echouer le calcul, plutot que de produire un trafic faux.
CLES_PAR_PRODUIT=CO:colis,OO:oo,IP:potentielip,OS:3s,PR:3s,PPI:3s

# Plafond d'un trafic PDI : au-dela, le scenario est rejete avec un message explicite.
# 99999999 = capacite de trppu_trafic_pdi.dense/faible1/faible2 en decimal(12,4).
# Vide = aucun controle : un trafic trop grand remonte l'erreur MySQL (1264 Out of range).
TRAFIC_MAX=99999999

# Ecriture des trafics PDI : nombre de lignes par INSERT. Tous les lots sont dans une seule
# transaction (rollback complet en cas d'erreur). Vide ou invalide = 5000, <= 0 = 1.
TAILLE_LOT=5000

# DSR-729 - suivi des executions (trppu_suivi_batch) et unicite d'instance.
# Une execution EN_COURS depuis plus de N minutes est reputee abandonnee (pod tombe) :
# passee en ECHEC, et le nouveau lancement demarre. Doit rester >= timeout du pod YB05.
SUIVI_BATCH_TIMEOUT_MINUTES=60

# Pour tracer les requetes
DEBUG_SHOW_QUERY=false

# json_formatter configuration
APP=dsr
APP_ENV=sdev  # Pour les env nous avons local,sdev,sacc,sass,prod
MODULE=yb05
APP_VERSION=1.0.0
# LOGS_DIR=/logs  (optionnel, utilise uniquement si APP_ENV=local ou chemin explicite)
