# Pour MYSQL
SGBD_SERVER_READ=localhost
SGBD_SERVER_WRITE=localhost
SGBD_PORT=3306
SGBD_DB_NAME=yb05
SGBD_APP_USER_READ=root
SGBD_APP_USER_WRITE=root
SGBD_APP_USER=root
#SGBD_APP_PWD=your_password
#SGBD_APP_PWD_READ=your_read_password
#SGBD_APP_PWD_WRITE=your_write_password
SGBD_MAX_RETRIES=3
SGBD_RETRY_DELAY=1.0

# Scripts SQL : taille (octets) au-dela de laquelle un avertissement est logge
# (le fichier est entierement charge en memoire avant decoupage).
SQL_SCRIPT_WARN_SIZE=10485760

# Mode ALL (DSR-704) : nombre de scenarios traites simultanement.
# 1 = sequentiel (defaut). La taille des pools MySQL suit cette valeur.
NB_WORKER=1

# Calcul des trafics PDI (DSR-702) : quelle cle de repartition appliquer a quel produit.
# Familles reconnues : colis, oo, 3s, potentielip. Un produit absent de cette liste fait
# echouer le calcul, plutot que de produire un trafic faux.
CLES_PAR_PRODUIT=CO:colis,OO:oo,IP:potentielip,OS:3s,PR:3s,PPI:3s

# Pour tracer les requetes
DEBUG_SHOW_QUERY=false

# json_formatter configuration
APP=dsr
APP_ENV=sdev  # Pour les env nous avons local,sdev,sacc,sass,prod
MODULE=yb05
APP_VERSION=1.0.0
# LOGS_DIR=/logs  (optionnel, utilise uniquement si APP_ENV=local ou chemin explicite)
